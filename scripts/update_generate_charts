def save_report_figure(fig, filename):
    """Apply the shared report style without changing chart data or explicit ticks.

    Keep categorical/heatmap ticks intact. Numeric axes get sparse ticks and
    readable numbers; secondary axes never add a second set of grid lines.
    Legends sit below their own panel, outside the data area.
    """
    from matplotlib.ticker import FixedLocator

    fig.set_size_inches(max(fig.get_figwidth(), 12), max(fig.get_figheight(), 5.6))
    primary_axes = []
    for ax in fig.axes:
        if not ax.axison:
            continue
        is_twin = any(ax.get_shared_x_axes().joined(ax, other)
                      and ax.get_position().bounds == other.get_position().bounds
                      for other in primary_axes)
        if not is_twin:
            primary_axes.append(ax)
        ax.set_axisbelow(True)
        ax.grid(False)
        ax.spines['top'].set_visible(False)
        ax.spines['right' if not is_twin else 'left'].set_visible(False)
        ax.spines['bottom'].set_color('#D5DDDC')
        ax.tick_params(axis='both', which='both', length=0, pad=7, labelsize=8,
                       labelcolor=BSI_NAVY)
        for axis in (ax.xaxis, ax.yaxis):
            if not isinstance(axis.get_major_locator(), FixedLocator):
                axis.set_major_locator(MaxNLocator(nbins=5, min_n_ticks=3))
                axis.set_major_formatter(StrMethodFormatter('{x:,.12g}'))
        if not is_twin and not ax.images:
            ax.yaxis.grid(True, color='#E5E8E8', linewidth=0.6, alpha=0.7)
        for get_label, set_label in ((ax.get_xlabel, ax.set_xlabel),
                                     (ax.get_ylabel, ax.set_ylabel)):
            label = get_label()
            if label:
                set_label(textwrap.fill(label, 48), fontsize=8.5,
                          fontweight='normal', labelpad=10)
        title = ax.get_title(loc='left')
        if title:
            ax.set_title(textwrap.fill(title, 100 if len(fig.axes) == 1 else 65), loc='left', fontsize=10,
                         fontweight='bold', color=BSI_DARK_TEAL, pad=16)
        for tick in ax.get_xticklabels():
            tick.set_rotation(0)
            tick.set_horizontalalignment('center')
            tick.set_fontweight('normal')
        legend = ax.get_legend()
        if legend is not None:
            handles = legend.legend_handles if hasattr(legend, 'legend_handles') else legend.legendHandles
            labels = [textwrap.fill(t.get_text(), 42) for t in legend.get_texts()]
            legend.remove()
            ax.legend(handles, labels, loc='upper center',
                      bbox_to_anchor=(0.5, -0.23), ncol=2 if len(labels) > 3 else 1,
                      fontsize=7.4, frameon=False, handlelength=2,
                      columnspacing=1.4, labelspacing=0.7)
    fig.tight_layout(pad=1.6, w_pad=4.5, h_pad=3.0)
    fig.savefig(os.path.join(CHARTS_DIR, filename), dpi=300,
                bbox_inches='tight', pad_inches=0.18)


