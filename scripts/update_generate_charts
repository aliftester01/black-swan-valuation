    ax1.axhline(13.49, color=BSI_RED, ls=":", lw=1.5, label="OJK Minimum CAR incl. Buffers (13.49%)")
    for i in [0, 4, 5, 6, 9, 14]:
        ax1.text(i, car[i] + 0.5, f"{car[i]:.1f}%", ha="center", fontsize=7.1, fontweight="bold", color=BSI_NAVY)

    ax1.set_xticks(x[::2])
